{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeqMapMigrationDynamoDbWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-1:287190274071:table/bm_seq_counter"
    },
    {
      "Sid": "SeqMapMigrationS3Read",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::aws-s3-outputs-csv/seqmap/seqmap.pkl"
    }
  ]
}
