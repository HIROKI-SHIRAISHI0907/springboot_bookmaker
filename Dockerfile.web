# syntax=docker/dockerfile:1.6
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

# まず POM だけ（キャッシュ効かせる）
COPY bookmakers-parents/pom.xml bookmakers-parents/pom.xml
COPY bookmakers-common-data/pom.xml bookmakers-common-data/pom.xml
COPY bookmakers-web/pom.xml bookmakers-web/pom.xml

# 親POMを modules 無視でローカルinstall
RUN --mount=type=cache,target=/root/.m2 \
    mvn -N -f bookmakers-parents/pom.xml -DskipTests -Dmaven.test.skip=true install

# ソース投入
COPY bookmakers-common-data/ bookmakers-common-data/
COPY bookmakers-web/ bookmakers-web/

# common-data → web
RUN --mount=type=cache,target=/root/.m2 \
    mvn -f bookmakers-common-data/pom.xml -DskipTests -Dmaven.test.skip=true clean install && \
    mvn -f bookmakers-web/pom.xml -DskipTests -Dmaven.test.skip=true clean package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/bookmakers-web/target/*.jar /app/web.jar
EXPOSE 8080
ENTRYPOINT ["java","-jar","/app/web.jar"]

